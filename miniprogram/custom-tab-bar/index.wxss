.tabbar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  display: flex;
  height: calc(120rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff;
  box-shadow: 0 -4rpx 24rpx rgba(45, 49, 66, 0.06);
  z-index: 999;
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: #8A8FA3;
  transition: color .2s;
}
.tab-item.on { color: #3A9E8F; }
.tab-icon { width: 56rpx; height: 56rpx; }
.tab-text { font-size: 24rpx; font-weight: 600; }
