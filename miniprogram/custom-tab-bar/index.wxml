<view class="tabbar">
  <view
    wx:for="{{list}}"
    wx:key="index"
    class="tab-item {{selected===index?'on':''}}"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <image class="tab-icon" src="{{selected===index?item.selectedIconPath:item.iconPath}}" mode="aspectFit" />
    <view class="tab-text">{{item.text}}</view>
  </view>
</view>
