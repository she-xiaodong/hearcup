<view class="page-bg">
  <view class="topbar">
    <view class="section-title" style="margin:0;">资料与价格设置</view>
    <view class="muted">修改后实时生效，用户端展示 H币（1 元 = 10 H币）</view>
  </view>

  <view wx:if="{{loading}}" class="empty">加载中…</view>

  <block wx:elif="{{ok}}">
    <!-- 基本资料 -->
    <view class="card f-card">
      <view class="f-title">基本资料</view>

      <view class="f-row">
        <view class="f-label">个人介绍</view>
        <textarea class="f-input f-area" placeholder="介绍一下自己，帮助来电者更信任你" value="{{form.intro}}" maxlength="200" data-f="intro" bindinput="onInput" />
      </view>

      <view class="f-row">
        <view class="f-label">城市</view>
        <input class="f-input" placeholder="所在城市" value="{{form.city}}" data-f="city" bindinput="onInput" />
      </view>

      <view class="f-row">
        <view class="f-label">年龄</view>
        <input class="f-input" type="number" placeholder="≥18" value="{{form.age}}" data-f="age" bindinput="onInput" />
      </view>

      <view class="f-row">
        <view class="f-label">学历</view>
        <input class="f-input" placeholder="如：心理学本科" value="{{form.education}}" data-f="education" bindinput="onInput" />
      </view>

      <view class="f-row">
        <view class="f-label">专业</view>
        <input class="f-input" placeholder="专业背景" value="{{form.major}}" data-f="major" bindinput="onInput" />
      </view>

      <view class="f-row">
        <view class="f-label">从业年限(年)</view>
        <input class="f-input" type="number" value="{{form.years_of_exp}}" data-f="years_of_exp" bindinput="onInput" />
      </view>

      <view class="f-row">
        <view class="f-label">咨询时长(小时)</view>
        <input class="f-input" type="number" value="{{form.consult_hours}}" data-f="consult_hours" bindinput="onInput" />
      </view>

      <view class="f-row">
        <view class="f-label">证书/背景</view>
        <input class="f-input" placeholder="受训背景等（选填）" value="{{form.background}}" data-f="background" bindinput="onInput" />
      </view>

      <view class="f-row f-col">
        <view class="f-label">擅长领域（可多选）</view>
        <view class="f-tags">
          <text
            wx:for="{{tags}}"
            wx:key="name"
            class="f-tag {{item.on ? 'on' : ''}}"
            data-tag="{{item.name}}"
            bindtap="toggleTag"
          >{{item.name}}</text>
        </view>
      </view>
    </view>

    <!-- 档位价格 -->
    <view class="card f-card">
      <view class="f-title">时长档位价格（单位：元）</view>
      <view class="muted f-sub">至少保留一档；用户端看到的 H币 = 元 × 10</view>
      <view class="f-tiers">
        <view wx:for="{{tiers}}" wx:key="minutes" class="f-tier">
          <view class="f-tier-label">{{item.minutes}}分钟</view>
          <view class="f-tier-input-wrap">
            <input class="f-tier-input" type="digit" value="{{item.yuan}}" data-idx="{{index}}" bindinput="onTierInput" placeholder="0.00" />
            <text class="f-tier-unit">元</text>
          </view>
          <view class="f-tier-coins">{{item.coins || '-'}} H币</view>
        </view>
      </view>
    </view>

    <button class="btn btn-primary btn-block f-save" bindtap="onSave" loading="{{saving}}">保存修改</button>
  </block>

  <view class="safe-bottom"></view>
</view>
