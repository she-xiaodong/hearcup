.profile-head { display: flex; align-items: flex-start; justify-content: flex-start; gap: 20rpx; margin: 24rpx 32rpx; text-align: left; }
.avatar-btn { padding: 0; margin: 0; background: transparent; line-height: normal; border: none; width: 116rpx; height: 116rpx; min-width: 116rpx; display: block; flex-shrink: 0; }
.avatar-btn::after { border: none; }
.head-avatar { width: 116rpx; height: 116rpx; font-size: 52rpx; border-radius: 50%; overflow: hidden; }
.head-avatar-img { width: 116rpx; height: 116rpx; border-radius: 50%; display: block; }
.head-info { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; justify-content: flex-start; text-align: left; }
.head-name { font-size: 38rpx; font-weight: 800; }
.head-name-input { font-size: 38rpx; font-weight: 800; height: 64rpx; line-height: 64rpx; width: 100%; text-align: left; padding: 0; }
.h-no { margin-top: 6rpx; font-size: 26rpx; font-weight: 700; color: var(--primary-deep, #2E8578); letter-spacing: 1rpx; text-align: left; }
.head-phone { font-size: 24rpx; margin-top: 4rpx; text-align: left; }

.balance-row { display: flex; align-items: center; justify-content: space-between; margin: 0 32rpx 24rpx; }
.balance-num { font-size: 48rpx; font-weight: 800; color: var(--peach); margin-top: 6rpx; }
.recharge-mini { margin: 0; line-height: 64rpx; height: 64rpx; padding: 0 32rpx; }

/* 成为服务者 */
.become { margin: 0 32rpx 24rpx; background: linear-gradient(135deg, #E6F4F4, #D6ECEC); border-radius: var(--radius); padding: 32rpx; }
.become-title { font-size: 32rpx; font-weight: 800; }
.become-sub { font-size: 24rpx; margin: 8rpx 0 20rpx; line-height: 1.6; }
.become-roles { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.become-role { flex: 1; background: #fff; border-radius: 16rpx; padding: 16rpx; text-align: center; }
.become-role .er-icon { width: 44rpx; height: 44rpx; margin: 0 auto; }
.become-role .er-name { font-size: 26rpx; font-weight: 700; margin-top: 4rpx; }

/* 审核中 */
.pending { margin: 0 32rpx 24rpx; background: #FFF7E6; border-radius: var(--radius); padding: 40rpx 32rpx; text-align: center; }
.pending-icon { width: 72rpx; height: 72rpx; margin: 0 auto; }
.pending-title { font-size: 30rpx; font-weight: 700; margin-top: 8rpx; }

/* 倾听者平台入口横幅（原「倾听者中心」功能已并入平台页） */
.pv-entry {
  display: flex; align-items: center; gap: 24rpx;
  margin: 0 32rpx 24rpx;
  background: linear-gradient(135deg, #3A9E8F, #2E8578);
  border-radius: var(--radius);
  padding: 30rpx 32rpx;
  box-shadow: var(--shadow);
}
.pv-e-ico {
  width: 60rpx; height: 60rpx;
  flex-shrink: 0;
}
.pv-e-main { flex: 1; min-width: 0; }
.pv-e-title { font-size: 32rpx; font-weight: 800; color: #fff; }
.pv-e-sub { font-size: 22rpx; color: rgba(255, 255, 255, 0.85); margin-top: 4rpx; }
.pv-e-arrow { color: rgba(255, 255, 255, 0.9); font-size: 40rpx; }

.menu { margin: 0 32rpx; }
.mi-left { display: flex; align-items: center; gap: 16rpx; }
.menu-item { display: flex; align-items: center; justify-content: space-between; padding: 28rpx 0; border-top: 1rpx solid var(--line); font-size: 30rpx; }
.menu-item:first-child { border-top: none; }
.menu-badge { color: var(--text-sub); font-size: 26rpx; }

.tab-foot { height: calc(180rpx + env(safe-area-inset-bottom)); }
