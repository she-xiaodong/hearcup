<view class="page-bg">
  <view class="card profile-head">
    <view class="avatar head-avatar" style="background:linear-gradient(135deg,#4FB8A8,#FF9E80)"><view class="ico ico-user-w" style="width:52rpx;height:52rpx;"></view></view>
    <view class="head-info">
      <view class="head-name">{{user.nickName}}</view>
      <view class="muted">{{user.phone}}</view>
    </view>
  </view>

  <view class="card balance-row" bindtap="goRecharge">
    <view>
      <view class="muted">账户余额</view>
      <view class="balance-num">¥ {{balance}}</view>
    </view>
    <view class="btn btn-ghost recharge-mini">去充值</view>
  </view>

  <!-- 未入驻：成为服务者 -->
  <view wx:if="{{!apply}}" class="become">
    <view class="become-title">成为服务者，用你的温度陪别人一会儿</view>
    <view class="become-sub">倾听师与咨询师都在这个小程序里完成入驻，审核通过即可接听来电。</view>
    <view class="become-roles">
      <view class="become-role"><view class="er-icon ico ico-leaf"></view><view class="er-name">倾听师</view></view>
      <view class="become-role"><view class="er-icon ico ico-lotus"></view><view class="er-name">咨询师</view></view>
    </view>
    <button class="btn btn-primary btn-block" bindtap="goApply">申请入驻</button>
  </view>

  <!-- 待审核 -->
  <view wx:elif="{{apply.status===0}}" class="pending">
    <view class="pending-icon ico ico-hourglass"></view>
    <view class="pending-title">入驻申请审核中</view>
    <view class="muted" style="margin-top:8rpx;">你申请的是「{{apply.role===1?'倾听师':'咨询师'}}」，预计 1-3 个工作日出结果。</view>
  </view>

  <!-- 已通过：服务者中心 -->
  <view wx:elif="{{isProvider}}" class="provider">
    <view class="pv-top">
      <view class="pv-title">服务者中心 · {{apply.role===1?'倾听师':'咨询师'}}</view>
      <switch checked="{{me.isOnline}}" bindchange="toggleOnline" color="#4FB8A8" />
    </view>
    <view class="pv-grid">
      <view class="pv-cell"><view class="pv-num">{{me.todayCalls}}/{{me.dailyLimit}}</view><view class="pv-label">今日接听</view></view>
      <view class="pv-cell"><view class="pv-num">¥{{me.todayIncome}}</view><view class="pv-label">今日收益</view></view>
      <view class="pv-cell"><view class="pv-num">¥{{me.totalIncome}}</view><view class="pv-label">累计收益</view></view>
      <view class="pv-cell"><view class="pv-num">¥{{me.withdrawable}}</view><view class="pv-label">可提现</view></view>
    </view>
    <view class="pv-actions">
      <button class="btn btn-ghost" bindtap="goEarnings">收益明细</button>
      <button class="btn btn-primary" bindtap="goWithdraw">申请提现</button>
    </view>
  </view>

  <view class="card menu">
    <view class="menu-item" bindtap="goCalls"><view class="mi-left"><view class="ico ico-phone ico-sm"></view><text>通话记录</text></view><text class="menu-badge">{{callCount}} 条 ›</text></view>
    <view class="menu-item" bindtap="goRecharge"><view class="mi-left"><view class="ico ico-wallet ico-sm"></view><text>余额与充值</text></view><text class="muted">›</text></view>
    <view class="menu-item"><view class="mi-left"><view class="ico ico-gear ico-sm"></view><text>设置</text></view><text class="muted">›</text></view>
    <view class="menu-item" bindtap="goDevcheck"><view class="mi-left"><view class="ico ico-wrench ico-sm"></view><text>开发者自检</text></view><text class="muted">›</text></view>
    <view class="menu-item" bindtap="logout"><view class="mi-left"><view class="ico ico-logout ico-sm"></view><text>退出登录</text></view><text class="muted">›</text></view>
  </view>

  <view class="tab-foot"></view>
</view>
