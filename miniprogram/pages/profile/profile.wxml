<view class="page-bg">
  <view class="card profile-head">
    <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
      <image wx:if="{{user.avatar}}" class="head-avatar-img" src="{{user.avatar}}" mode="aspectFill" />
      <view wx:else class="avatar head-avatar" style="background:linear-gradient(135deg,#008C8C,#00A8A8)"><view class="ico ico-user-w" style="width:52rpx;height:52rpx;"></view></view>
    </button>
    <view class="head-info">
      <input class="head-name-input" type="nickname" placeholder="点击设置昵称" value="{{user.nickName}}" bindblur="onNicknameBlur" />
      <view class="h-no">H号：{{user.h_no}}</view>
      <view class="muted">{{user.phone}}</view>
    </view>
  </view>

  <view class="card balance-row" bindtap="goRecharge">
    <view>
      <view class="muted">账户余额（H币）</view>
      <view class="balance-num">{{balance}}</view>
    </view>
    <view class="btn btn-ghost recharge-mini">去充值</view>
  </view>

  <!-- 未入驻：成为倾听者 -->
  <view wx:if="{{!apply}}" class="become">
    <view class="become-title">成为倾听者，用你的温度陪别人一会儿</view>
    <view class="become-sub">通过审核后即可上线接听来电，获得收益。</view>
    <button class="btn btn-primary btn-block" bindtap="goApply">申请入驻</button>
  </view>

  <!-- 待审核 -->
  <view wx:elif="{{apply.status===0}}" class="pending">
    <view class="pending-icon ico ico-hourglass"></view>
    <view class="pending-title">入驻申请审核中</view>
    <view class="muted" style="margin-top:8rpx;">你申请成为「倾听者」，预计 1-3 个工作日出结果。</view>
  </view>

  <!-- 已通过：倾听者中心 -->
  <view wx:elif="{{isProvider}}" class="provider">
    <view class="pv-top">
      <view class="pv-title">倾听者中心</view>
      <switch checked="{{me.isOnline}}" bindchange="toggleOnline" color="#008C8C" />
    </view>
    <view class="pv-grid">
      <view class="pv-cell"><view class="pv-num">¥{{me.pendingIncome}}</view><view class="pv-label">未完成收入</view></view>
      <view class="pv-cell"><view class="pv-num">¥{{me.completedIncome}}</view><view class="pv-label">已完成收入</view></view>
    </view>
    <view class="pv-actions">
      <button class="btn btn-ghost" bindtap="goEarnings">收益明细</button>
      <button class="btn btn-primary" bindtap="goWithdraw">申请提现</button>
    </view>
  </view>

  <view class="card menu">
    <view class="menu-item" bindtap="goCalls"><view class="mi-left"><view class="ico ico-phone ico-sm"></view><text>通话记录</text></view><text class="menu-badge">{{callCount}} 条 ›</text></view>
    <view class="menu-item" bindtap="goRecharge"><view class="mi-left"><view class="ico ico-wallet ico-sm"></view><text>余额与充值</text></view><text class="muted">›</text></view>
    <view class="menu-item" bindtap="goAbout"><view class="mi-left"><view class="ico ico-leaf ico-sm"></view><text>关于我们</text></view><text class="muted">›</text></view>
    <view class="menu-item" bindtap="goFeedback"><view class="mi-left"><view class="ico ico-chat ico-sm"></view><text>意见反馈</text></view><text class="muted">›</text></view>
    <view class="menu-item" bindtap="goSettings"><view class="mi-left"><view class="ico ico-gear ico-sm"></view><text>设置</text></view><text class="muted">›</text></view>
    <view class="menu-item" bindtap="goDevcheck"><view class="mi-left"><view class="ico ico-wrench ico-sm"></view><text>开发者自检</text></view><text class="muted">›</text></view>
  </view>

  <view class="tab-foot"></view>
</view>
