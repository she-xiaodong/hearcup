.call-screen {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: calc(120rpx + env(safe-area-inset-top)) 40rpx calc(80rpx + env(safe-area-inset-bottom));
  background: linear-gradient(160deg, #007A7A 0%, #2C7E73 55%, #244E5E 100%);
  color: #fff;
}
.call-screen.video { background: linear-gradient(160deg, #2C7E73 0%, #1F3A47 100%); }

.call-top { text-align: center; }
.call-status { font-size: 30rpx; opacity: 0.9; }
.call-timer {
  font-size: 64rpx; font-weight: 800; letter-spacing: 4rpx; margin-top: 12rpx;
  font-variant-numeric: tabular-nums;
}

.call-center { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 18rpx; }
.call-avatar-img {
  width: 220rpx; height: 220rpx; border-radius: 50%;
  border: 6rpx solid rgba(255,255,255,0.35);
  box-shadow: 0 0 0 16rpx rgba(255,255,255,0.08);
}
.call-name { font-size: 44rpx; font-weight: 800; margin-top: 20rpx; }
.call-role { font-size: 26rpx; opacity: 0.8; }

.call-controls { display: flex; align-items: flex-end; justify-content: space-around; width: 100%; padding-top: 40rpx; }
.ctrl { display: flex; flex-direction: column; align-items: center; gap: 12rpx; }
.ctrl-btn {
  width: 110rpx; height: 110rpx; border-radius: 50%;
  background: rgba(255,255,255,0.18);
  display: flex; align-items: center; justify-content: center;
  font-size: 48rpx;
}
.ctrl-btn.ctrl-off { background: rgba(255,107,107,0.35); }
.ctrl-label { font-size: 24rpx; opacity: 0.9; }
.ctrl-hangup {
  width: 130rpx; height: 130rpx; border-radius: 50%;
  background: #FF6B6B;
  display: flex; align-items: center; justify-content: center;
  font-size: 60rpx;
  transform: rotate(135deg);
  box-shadow: 0 10rpx 30rpx rgba(255,107,107,0.45);
}
.hangup-label { color: #FFD0D0; }
