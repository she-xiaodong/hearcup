<view class="call-screen {{videoOn?'video':''}}">
  <view class="call-top">
    <view class="call-status">{{statusText}}</view>
    <view class="call-timer" wx:if="{{status==='connected'}}">{{timerText}}</view>
  </view>

  <view class="call-center">
    <view class="avatar call-avatar" style="background:{{p.avatarColor}}"><view class="ico ico-{{p.role==2?'lotus-w':'leaf-w'}}" style="width:90rpx;height:90rpx;"></view></view>
    <view class="call-name">{{p.nickName}}</view>
    <view class="call-role">{{callType===2?'视频通话':'语音通话'}} · {{p.levelText}}</view>
  </view>

  <view class="call-controls">
    <view class="ctrl" bindtap="toggleMute">
      <view class="ctrl-btn {{muted?'ctrl-off':''}}"><view class="ico ico-{{muted?'mic-off-w':'mic-w'}}" style="width:48rpx;height:48rpx;"></view></view>
      <text class="ctrl-label">{{muted?'已静音':'静音'}}</text>
    </view>
    <view class="ctrl" bindtap="toggleVideo">
      <view class="ctrl-btn"><view class="ico ico-{{videoOn?'video-w':'video-off-w'}}" style="width:48rpx;height:48rpx;"></view></view>
      <text class="ctrl-label">{{videoOn?'视频':'语音'}}</text>
    </view>
    <view class="ctrl">
      <view class="ctrl-hangup" bindtap="hangup"><view class="ico ico-phone-white" style="width:56rpx;height:56rpx;"></view></view>
      <text class="ctrl-label hangup-label">挂断</text>
    </view>
  </view>
</view>
