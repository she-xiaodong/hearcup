/* 通话页：整体参考微信语音通话界面（深色沉浸底 + 顶部头像信息 + 底部圆形按钮） */
.call-page {
  min-height: 100vh;
  box-sizing: border-box;
  background: linear-gradient(180deg, #2b3a42 0%, #1b262c 55%, #121a1f 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx 80rpx;
  color: #fff;
}

/* ---------- 顶部 ---------- */
.top {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 40rpx;
}

.avatar {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.25);
  background: rgba(255, 255, 255, 0.08);
}

.nickname {
  margin-top: 28rpx;
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.status-text {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.65);
}

.timer {
  margin-top: 16rpx;
  font-size: 34rpx;
  color: rgba(255, 255, 255, 0.9);
  font-variant-numeric: tabular-nums;
}

/* ---------- 订单信息 ---------- */
.order-card {
  width: 100%;
  margin-top: 56rpx;
  padding: 28rpx 32rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
}

.order-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
}

.order-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
}

.order-value {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}

/* ---------- 号码提示 ---------- */
.phone-hint {
  margin-top: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hint-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

.hint-phone {
  margin-top: 10rpx;
  font-size: 44rpx;
  letter-spacing: 2rpx;
  font-weight: 600;
}

.hint-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.45);
}

/* ---------- 底部按钮 ---------- */
.bottom {
  margin-top: auto;
  padding-top: 60rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.btn-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 56rpx;
}

.btn-ring {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.25);
}

.btn-icon {
  font-size: 46rpx;
  color: #fff;
}

.btn-green { background: #07c160; }
.btn-red   { background: #fa5151; }
.btn-gray  { background: rgba(255, 255, 255, 0.18); }

.btn-caption {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* ---------- 结束汇总 ---------- */
.summary {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}

.summary-line {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  padding: 6rpx 0;
}
