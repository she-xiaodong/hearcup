.summary { display: flex; margin: 0 32rpx 24rpx; }
.sum-item { flex: 1; text-align: center; }
.sum-num { font-size: 40rpx; font-weight: 800; color: var(--primary-deep); }
.sum-item + .sum-item .sum-num { color: var(--peach); }

.list { margin: 0 32rpx; }
.call { display: flex; align-items: center; gap: 20rpx; padding: 24rpx 0; border-top: 1rpx solid var(--line); }
.call:first-child { border-top: none; }
.call-avatar { width: 84rpx; height: 84rpx; font-size: 38rpx; }
.call-mid { flex: 1; }
.call-name { font-size: 30rpx; font-weight: 700; }
.call-sub { font-size: 22rpx; margin-top: 4rpx; }
.call-right { text-align: right; }
.call-amt { font-size: 28rpx; font-weight: 700; }
.todo { font-size: 22rpx; }

/* 待评价按钮 */
.rate-btn {
  display: inline-block;
  font-size: 22rpx;
  color: var(--primary-deep);
  background: var(--primary-soft);
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

.tab-foot { height: calc(180rpx + env(safe-area-inset-bottom)); }

/* 评价弹层 */
.rate-mask {
  position: fixed; inset: 0;
  background: rgba(0,0,0,0.45);
  z-index: 1000;
  display: flex; align-items: flex-end;
}
.rate-sheet {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
}
.rate-title { font-size: 32rpx; font-weight: 700; text-align: center; margin-bottom: 24rpx; }
.rate-stars { display: flex; justify-content: center; gap: 16rpx; margin-bottom: 24rpx; }
.rate-star { font-size: 60rpx; color: #E0E0E0; line-height: 1; }
.rate-star.on { color: var(--gold); }
.rate-textarea {
  width: 100%; height: 160rpx;
  background: var(--bg);
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}
.rate-actions { display: flex; gap: 20rpx; margin-top: 28rpx; }
.rate-cancel { flex: 1; margin: 0; }
.rate-confirm { flex: 1; margin: 0; }
