<view class="page-bg">
  <view class="topbar">
    <view class="section-title" style="margin:0;">通话记录</view>
    <view class="muted">全部通话都在这儿</view>
  </view>

  <view class="summary card">
    <view class="sum-item">
      <view class="sum-num">{{totalCount}}</view>
      <view class="muted">总通话</view>
    </view>
    <view class="sum-item">
      <view class="sum-num">¥{{totalAmount}}</view>
      <view class="muted">总花费</view>
    </view>
    <view class="sum-item">
      <view class="sum-num">{{ratedCount}}</view>
      <view class="muted">已评价</view>
    </view>
  </view>

  <view class="card list">
    <view class="call" wx:for="{{records}}" wx:key="id">
      <view class="call-avatar avatar" style="background:{{item.color}}"><view class="ico ico-{{item.roleIcon?'lotus-w':'leaf-w'}}" style="width:42rpx;height:42rpx;"></view></view>
      <view class="call-mid">
        <view class="call-name">{{item.providerName}}
          <text class="tag {{item.callType===2?'tag-lav':'tag'}}">{{item.callType===2?'视频':'语音'}}</text>
        </view>
        <view class="muted call-sub">{{item.time}} · {{item.durationText}}</view>
      </view>
      <view class="call-right">
        <view class="call-amt">-¥{{item.amount}}</view>
        <view class="stars" wx:if="{{item.rating}}">★ {{item.rating}}</view>
        <view class="muted todo" wx:else>待评价</view>
      </view>
    </view>
    <view wx:if="{{records.length===0}}" class="empty">还没有通话记录，去首页找个服务者聊聊吧</view>
  </view>

  <view class="tab-foot"></view>
</view>
