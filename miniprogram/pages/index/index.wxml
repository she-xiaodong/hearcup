<view class="page-bg">
  <view class="topbar" style="padding-top: {{statusBarHeight}}px;">
    <image class="top-logo" src="/images/logo1.png" mode="aspectFit" />
  </view>

  <view class="hero card">
    <view class="hero-text">
      <view class="hero-title">一杯心晴</view>
      <view class="hero-sub">有人愿意，安静听你说</view>
      <view class="hero-chip"><view class="dot-online"></view>当前 {{onlineCount}} 位倾听者在线</view>
    </view>
    <image class="hero-img" src="/images/hero.jpg" mode="aspectFill" />
  </view>

  <view class="tabs">
    <view wx:for="{{roles}}" wx:key="id" class="tab {{activeRole===item.id?'tab-on':''}}" bindtap="switchRole" data-id="{{item.id}}">{{item.name}}</view>
  </view>

  <view class="list">
    <provider-card wx:for="{{list}}" wx:key="id" provider="{{item}}" bind:call="onCall" />
    <view wx:if="{{list.length===0}}" class="empty">暂无倾听者在线，请稍后再来</view>
  </view>

  <view class="safe-bottom"></view>
</view>
