<view class="page-bg">
  <!-- 步骤指示 -->
  <view class="progress" wx:if="{{step===0}}">
    <view class="dot on">1</view>
    <view class="line"></view>
    <view class="dot">2</view>
  </view>

  <!-- 步骤1：填写资料 -->
  <block wx:if="{{step===0}}">
    <view class="head">
      <view class="h-title">成为倾听者，填一份资料</view>
      <view class="muted">通过审核后即可上线接听来电，获得收益。</view>
    </view>

    <view class="card form">
      <view class="f-row">
        <text class="f-label">真实姓名</text>
        <input class="f-input" placeholder="展示给来访者" value="{{form.realName}}" bindinput="onInput" data-k="realName" />
      </view>
      <view class="f-row">
        <text class="f-label">性别</text>
        <picker mode="selector" range="{{genderOptions}}" range-key="label" value="{{genderIndex}}" bindchange="onGenderChange">
          <view class="f-input picker-value">{{genderOptions[genderIndex].label}}</view>
        </picker>
      </view>
      <view class="f-row">
        <text class="f-label">年龄</text>
        <input class="f-input" type="number" placeholder="年龄" value="{{form.age}}" bindinput="onInput" data-k="age" />
      </view>
      <view class="f-row">
        <text class="f-label">城市</text>
        <input class="f-input" placeholder="所在城市" value="{{form.city}}" bindinput="onInput" data-k="city" />
      </view>
      <view class="f-row">
        <text class="f-label">学历</text>
        <picker mode="selector" range="{{educationOptions}}" range-key="label" value="{{educationIndex}}" bindchange="onEducationChange">
          <view class="f-input picker-value">{{educationOptions[educationIndex].label}}</view>
        </picker>
      </view>
      <view class="f-row">
        <text class="f-label">专业背景</text>
        <input class="f-input" placeholder="心理学相关专业背景" value="{{form.major}}" bindinput="onInput" data-k="major" />
      </view>
      <view class="f-row">
        <text class="f-label">手机号</text>
        <input class="f-input" type="number" placeholder="用于接听与提现" value="{{form.phone}}" bindinput="onInput" data-k="phone" />
      </view>
      <view class="f-row">
        <text class="f-label">身份证号</text>
        <input class="f-input" placeholder="仅用于实名，AES加密存储" value="{{form.idCard}}" bindinput="onInput" data-k="idCard" />
      </view>
      <view class="f-row">
        <text class="f-label">从业年限</text>
        <input class="f-input" type="number" placeholder="从业年数" value="{{form.yearsOfExp}}" bindinput="onInput" data-k="yearsOfExp" />
      </view>
      <view class="f-row">
        <text class="f-label">咨询时长</text>
        <input class="f-input" type="number" placeholder="累计咨询小时数" value="{{form.consultHours}}" bindinput="onInput" data-k="consultHours" />
      </view>

      <view class="f-block">
        <view class="f-label">擅长领域 <text class="muted">(可多选)</text></view>
        <view class="chips">
          <view wx:for="{{allTags}}" wx:key="name"
                class="chip {{item.selected?'chip-on':''}}"
                bindtap="toggleTag" data-t="{{item.name}}">{{item.name}}</view>
        </view>
      </view>

      <view class="f-block">
        <view class="f-label">学历证书 <text class="muted">(图片，最多3张)</text></view>
        <view class="imgs">
          <view wx:for="{{form.educationImages}}" wx:key="*this" class="img-thumb">
            <image src="{{item}}" mode="aspectFill" />
          </view>
          <view wx:if="{{form.educationImages.length<3}}" class="img-add" bindtap="chooseEducation">＋</view>
        </view>
      </view>

      <view class="f-block">
        <view class="f-label">咨询师证书 <text class="muted">(图片，最多5张)</text></view>
        <view class="imgs">
          <view wx:for="{{form.counselorImages}}" wx:key="*this" class="img-thumb">
            <image src="{{item}}" mode="aspectFill" />
          </view>
          <view wx:if="{{form.counselorImages.length<5}}" class="img-add" bindtap="chooseCounselor">＋</view>
        </view>
      </view>

      <view class="f-row">
        <text class="f-label">证书编号</text>
        <input class="f-input" placeholder="咨询师资格证书编号" value="{{form.certificateNo}}" bindinput="onInput" data-k="certificateNo" />
      </view>

      <view class="f-block">
        <view class="f-label">个人简介</view>
        <textarea class="f-textarea" placeholder="用一两句话介绍你自己，让对方愿意走近你" value="{{form.intro}}" bindinput="onInput" data-k="intro" />
      </view>
    </view>

    <button class="btn btn-primary btn-block submit" bindtap="submit">提交入驻申请</button>
  </block>

  <!-- 步骤2：正在审核中 -->
  <block wx:if="{{step===1}}">
    <view class="done">
      <view class="done-icon ico ico-hourglass"></view>
      <view class="done-title">正在审核中</view>
      <view class="muted done-sub">你的入驻申请已提交，我们会在 1-3 个工作日内完成审核，结果将在这里显示。</view>
      <button class="btn btn-primary btn-block" bindtap="backHome">返回「我的」</button>
    </view>
  </block>

  <!-- 步骤3：审核通过 -->
  <block wx:if="{{step===2}}">
    <view class="done">
      <view class="done-icon ico ico-check"></view>
      <view class="done-title">审核通过</view>
      <view class="muted done-sub">恭喜！你已成为倾听者，可以上线接听来电、获得收益了。</view>
      <button class="btn btn-primary btn-block" bindtap="backHome">前往「我的」</button>
    </view>
  </block>

  <!-- 步骤4：审核未通过 -->
  <block wx:if="{{step===3}}">
    <view class="done">
      <view class="done-icon ico ico-sprout"></view>
      <view class="done-title">审核未通过</view>
      <view class="muted done-sub">很抱歉，你的申请未通过审核，可联系客服了解详情。</view>
      <button class="btn btn-primary btn-block" bindtap="backHome">返回「我的」</button>
    </view>
  </block>

  <view class="tab-foot"></view>
</view>
