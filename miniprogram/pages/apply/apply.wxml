<view class="page-bg">
  <!-- 步骤指示 -->
  <view class="progress" wx:if="{{step<2}}">
    <view class="dot {{step===0?'on':''}}">1</view>
    <view class="line"></view>
    <view class="dot {{step===1?'on':''}}">2</view>
    <view class="line"></view>
    <view class="dot">3</view>
  </view>

  <!-- 步骤1：选择角色 -->
  <block wx:if="{{step===0}}">
    <view class="head">
      <view class="h-title">你想以什么身份，陪别人一会儿？</view>
      <view class="muted">两种身份都在这个小程序里完成入驻</view>
    </view>

    <view class="role-card listener {{role===1?'sel':''}}" bindtap="pickRole" data-role="1">
      <view class="rc-icon ico ico-leaf"></view>
      <view class="rc-body">
        <view class="rc-name">倾听师</view>
        <view class="muted rc-desc">用陪伴和共情接住对方，擅长情绪疏导。¥1/分钟起。</view>
      </view>
      <view class="rc-check" wx:if="{{role===1}}">✓</view>
    </view>

    <view class="role-card counselor {{role===2?'sel':''}}" bindtap="pickRole" data-role="2">
      <view class="rc-icon ico ico-lotus"></view>
      <view class="rc-body">
        <view class="rc-name">咨询师</view>
        <view class="muted rc-desc">持国家心理咨询师证，提供专业咨询。¥2/分钟起，需上传证书。</view>
      </view>
      <view class="rc-check" wx:if="{{role===2}}">✓</view>
    </view>

    <button class="btn btn-primary btn-block next" disabled="{{!role}}" bindtap="toForm">下一步</button>
  </block>

  <!-- 步骤2：填写资料 -->
  <block wx:if="{{step===1}}">
    <view class="head">
      <view class="h-title">{{role===1?'倾听师':'咨询师'}}资料填写</view>
      <view class="muted back" bindtap="backRole">‹ 重新选择身份</view>
    </view>

    <view class="card form">
      <view class="f-row">
        <text class="f-label">昵称</text>
        <input class="f-input" placeholder="展示在服务者列表的名字" value="{{form.nickName}}" bindinput="onInput" data-k="nickName" />
      </view>
      <view class="f-row">
        <text class="f-label">手机号</text>
        <input class="f-input" type="number" placeholder="用于接听与提现" value="{{form.phone}}" bindinput="onInput" data-k="phone" />
      </view>
      <view class="f-row">
        <text class="f-label">身份证号</text>
        <input class="f-input" placeholder="仅用于实名，AES加密存储" value="{{form.idCard}}" bindinput="onInput" data-k="idCard" />
      </view>

      <view class="f-block">
        <view class="f-label">擅长领域 <text class="muted">(可多选)</text></view>
        <view class="chips">
          <view wx:for="{{allTags}}" wx:key="*this"
                class="chip {{form.expertise.indexOf(item)>-1?'chip-on':''}}"
                bindtap="toggleTag" data-t="{{item}}">{{item}}</view>
        </view>
      </view>

      <view class="f-block">
        <view class="f-label">资质证书 <text class="muted">(图片，最多5张)</text></view>
        <view class="imgs">
          <view wx:for="{{form.certImages}}" wx:key="*this" class="img-thumb">
            <image src="{{item}}" mode="aspectFill" />
          </view>
          <view wx:if="{{form.certImages.length<5}}" class="img-add" bindtap="chooseCert">＋</view>
        </view>
      </view>

      <!-- 咨询师专属字段 -->
      <block wx:if="{{role===2}}">
        <view class="f-row">
          <text class="f-label">证书编号</text>
          <input class="f-input" placeholder="国家二级/三级心理咨询师证编号" value="{{form.certNo}}" bindinput="onInput" data-k="certNo" />
        </view>
        <view class="f-block">
          <view class="f-label">证书照片</view>
          <view class="imgs">
            <view wx:if="{{form.certImage}}" class="img-thumb">
              <image src="{{form.certImage}}" mode="aspectFill" />
            </view>
            <view class="img-add" bindtap="chooseCertPhoto">＋</view>
          </view>
        </view>
        <view class="f-row">
          <text class="f-label">从业年限</text>
          <input class="f-input" type="number" placeholder="如 5" value="{{form.years}}" bindinput="onInput" data-k="years" />
        </view>
        <view class="f-block">
          <view class="f-label">专业背景</view>
          <textarea class="f-textarea" placeholder="受训经历、流派、擅长议题等" value="{{form.background}}" bindinput="onInput" data-k="background" />
        </view>
      </block>

      <view class="f-block">
        <view class="f-label">个人简介</view>
        <textarea class="f-textarea" placeholder="用一两句话介绍你自己，让对方愿意走近你" value="{{form.intro}}" bindinput="onInput" data-k="intro" />
      </view>
    </view>

    <button class="btn btn-primary btn-block submit" bindtap="submit">提交入驻申请</button>
  </block>

  <!-- 步骤3：提交成功 / 待审核 -->
  <block wx:if="{{step===2}}">
    <view class="done">
      <view class="done-icon ico ico-sprout"></view>
      <view class="done-title">申请已提交</view>
      <view class="muted done-sub">我们会在 1-3 个工作日内完成审核，结果将在「我的」中显示。</view>
      <button class="btn btn-primary btn-block" bindtap="backHome">返回「我的」</button>
    </view>
  </block>

  <view class="tab-foot"></view>
</view>
