<view class="container" wx:if="{{!loading && listener}}">
  <!-- 头像和基本信息 -->
  <view class="header">
    <image class="avatar" src="{{listener.avatar || '/images/default-avatar.png'}}" mode="aspectFill" />
    <view class="info">
      <text class="name">{{listener.real_name}}</text>
      <text class="tags">{{listener.city}} · 从业{{listener.years_of_exp || 0}}年</text>
      <view class="stats">
        <text class="rating">⭐ {{listener.rating || '5.0'}}</text>
        <text class="sessions">{{listener.total_sessions || 0}}次咨询</text>
      </view>
    </view>
  </view>

  <!-- 详细信息 -->
  <view class="detail-card">
    <view class="detail-item" wx:if="{{listener.gender !== undefined}}">
      <text class="label">性别</text>
      <text class="value">{{listener.gender === 0 ? '女' : '男'}}</text>
    </view>
    <view class="detail-item" wx:if="{{listener.age}}">
      <text class="label">年龄</text>
      <text class="value">{{listener.age}}岁</text>
    </view>
    <view class="detail-item" wx:if="{{listener.city}}">
      <text class="label">城市</text>
      <text class="value">{{listener.city}}</text>
    </view>
    <view class="detail-item" wx:if="{{listener.education}}">
      <text class="label">学历</text>
      <text class="value">{{listener.education}}</text>
    </view>
    <view class="detail-item" wx:if="{{listener.major}}">
      <text class="label">专业</text>
      <text class="value">{{listener.major}}</text>
    </view>
    <view class="detail-item" wx:if="{{listener.years_of_exp}}">
      <text class="label">从业年限</text>
      <text class="value">{{listener.years_of_exp}}年</text>
    </view>
    <view class="detail-item" wx:if="{{listener.consult_hours}}">
      <text class="label">咨询时长</text>
      <text class="value">{{listener.consult_hours}}小时</text>
    </view>
  </view>

  <!-- 个人介绍 -->
  <view class="intro-card">
    <text class="section-title">个人介绍</text>
    <text class="intro-text">{{listener.intro}}</text>
  </view>

  <!-- 擅长领域 -->
  <view class="expertise-card" wx:if="{{listener.expertise}}">
    <text class="section-title">擅长领域</text>
    <view class="tags-container">
      <text class="tag" wx:for="{{listener.expertise.split(',')}}" wx:key="index">{{item}}</text>
    </view>
  </view>

  <!-- 时长选择（价格统一以 H币 展示） -->
  <view class="price-card">
    <text class="section-title">选择时长</text>
    <view class="tiers">
      <view
        class="tier-item {{selectedMinutes === item.minutes ? 'active' : ''}}"
        wx:for="{{priceTiers}}"
        wx:key="minutes"
        data-minutes="{{item.minutes}}"
        data-price="{{item.price}}"
        data-coins="{{item.coins}}"
        bindtap="selectTier"
      >
        <text class="tier-label">{{item.label}}</text>
        <text class="tier-price">{{item.coins}} {{coinName}}</text>
      </view>
    </view>
    <view class="balance-tip">
      <text>当前余额 {{balanceCoins}} {{coinName}}</text>
      <text class="tip-lack" wx:if="{{!enough}}">余额不足，请先充值</text>
    </view>
  </view>

  <!-- 底部下单按钮 -->
  <view class="footer">
    <view class="total">
      <text class="total-label">合计：</text>
      <text class="total-price">{{selectedCoins}} {{coinName}}</text>
    </view>
    <button class="order-btn" bindtap="handleOrder">{{enough ? '立即下单' : '去充值'}}</button>
  </view>
</view>

<!-- 加载中 -->
<view class="loading" wx:if="{{loading}}">
  <text>加载中...</text>
</view>