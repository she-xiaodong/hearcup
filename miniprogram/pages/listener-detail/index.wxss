.container {
  padding-bottom: 160rpx;
}

/* 头部信息 */
.header {
  display: flex;
  padding: 30rpx;
  background: #fff;
  margin-bottom: 20rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

/* 第一行：名称 + 性别 + 等级 …… 在线/离线靠右 */
.name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}
.nl {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  flex: 1;
}
.name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 300rpx;
}
/* 性别小图标 */
.gen {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
  flex-shrink: 0;
}
.gen-m { background: #E8F1FC; color: #5B9BD5; }
.gen-f { background: #FDEAF1; color: #E56B9F; }
/* 等级徽标 */
.lv {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #E6F4F0;
  color: #2E8578;
  flex-shrink: 0;
}
/* 在线/离线 */
.st {
  font-size: 22rpx;
  font-weight: 600;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}
.st-on { background: #E6F7EE; color: #16A34A; }
.st-off { background: #F1F3F5; color: #9AA0A6; }

/* 第二行：评分 · 次咨询 · 从业年限 */
.stats {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6rpx;
  margin-top: 12rpx;
}
.rating { font-size: 24rpx; color: #FF9500; font-weight: 600; }
.sessions { font-size: 24rpx; color: #999; }
.dot { font-size: 24rpx; color: #ddd; margin: 0 6rpx; }

/* 第三行：城市 + H号 */
.sub {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999;
}
.sub-hno {
  font-size: 22rpx;
  font-weight: 600;
  color: #2E8578;
  letter-spacing: 1rpx;
}

/* 详情卡片 */
.detail-card,
.intro-card,
.expertise-card,
.price-card {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
  color: #333;
}

.detail-item {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-item:last-child {
  border-bottom: none;
}

.label {
  font-size: 28rpx;
  color: #666;
}

.value {
  font-size: 28rpx;
  color: #333;
}

/* 个人介绍 */
.intro-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #666;
}

/* 擅长领域标签 */
.tags-container {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  padding: 10rpx 24rpx;
  background: #E6F4F0;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #2E8578;
}

/* 时长下拉 */
.tier-select {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 30rpx;
  background: #F7FAF9;
  border: 2rpx solid #E0EDEA;
  border-radius: 16rpx;
}
.ts-main {
  display: flex;
  align-items: baseline;
  gap: 24rpx;
}
.ts-label { font-size: 30rpx; font-weight: 700; color: #333; }
.ts-price { font-size: 32rpx; font-weight: 800; color: #3A9E8F; }
.ts-arrow { font-size: 28rpx; color: #999; }

/* 余额提示 */
.balance-tip {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eee;
  font-size: 24rpx;
  color: #999;
}

.balance-tip .tip-lack {
  color: #fa5151;
}

/* 底部按钮 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.total {
  flex: 1;
  display: flex;
  align-items: baseline;
}

.total-label {
  font-size: 28rpx;
  color: #666;
}

.total-price {
  font-size: 40rpx;
  font-weight: bold;
  color: #3A9E8F;
}

.order-btn {
  width: 240rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #3A9E8F, #2E8578);
  color: #fff;
  border: none;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
  padding: 0;
  margin: 0;
}
.order-btn::after { border: none; }
.order-btn-full {
  width: 100%;
  background: linear-gradient(135deg, #3A9E8F, #2E8578);
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  font-size: 28rpx;
  color: #999;
}
