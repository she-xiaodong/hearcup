/* pages/listener/listener —— 倾听者工作台 */
.topbar { padding: 24rpx 32rpx 8rpx; }
.listener-title { font-size: 40rpx; font-weight: 800; }

/* 统一卡片左右留白 */
.listener-card { margin: 0 32rpx 24rpx; }

/* 未申请 */
.become { background: linear-gradient(135deg, #E6F4F4, #D6ECEC); }
.become-title { font-size: 32rpx; font-weight: 800; }
.become-sub { font-size: 24rpx; margin: 8rpx 0 20rpx; line-height: 1.6; color: var(--text-sub); }

/* 待审核 / 已拒绝 */
.pending { background: #FFF7E6; text-align: center; }
.pending-icon { width: 72rpx; height: 72rpx; margin: 0 auto; }
.pending-title { font-size: 30rpx; font-weight: 700; margin-top: 8rpx; }

/* 在线开关 */
.row { display: flex; align-items: center; justify-content: space-between; }
.row-main { flex: 1; min-width: 0; margin-right: 16rpx; }
.row-title { font-size: 30rpx; font-weight: 700; }

/* 收益 */
.earn-grid { display: flex; margin-top: 8rpx; }
.earn-cell { flex: 1; text-align: center; position: relative; }
.earn-cell::after { content: ''; position: absolute; right: 0; top: 10rpx; bottom: 10rpx; width: 1rpx; background: var(--line); }
.earn-cell:last-child::after { display: none; }
.earn-num { font-size: 34rpx; font-weight: 800; color: var(--primary-deep); }
.earn-label { font-size: 22rpx; margin-top: 6rpx; color: var(--text-sub); }
.earn-total { text-align: center; margin-top: 20rpx; font-size: 24rpx; }

/* 低版本 Android 警告 */
.warn { background: #FFF7E6; }
.warn-title { font-size: 28rpx; font-weight: 700; color: #B8860B; margin-bottom: 8rpx; }

/* 保活引导 */
.keep-guide { display: flex; align-items: center; justify-content: space-between; margin-top: 24rpx; padding-top: 24rpx; border-top: 1rpx solid var(--line); }
.kg-main { flex: 1; min-width: 0; margin-right: 16rpx; }
.kg-title { font-size: 28rpx; font-weight: 700; }
