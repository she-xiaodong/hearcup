/* pages/listener/listener —— 倾听者平台 */
.topbar { padding: 24rpx 32rpx 8rpx; }
.listener-title { font-size: 40rpx; font-weight: 800; }

/* 统一卡片左右留白 */
.listener-card { margin: 0 32rpx 24rpx; }

/* 未申请 */
.become { background: linear-gradient(135deg, #E6F4F4, #D6ECEC); }
.become-title { font-size: 32rpx; font-weight: 800; }
.become-sub { font-size: 24rpx; margin: 8rpx 0 20rpx; line-height: 1.6; color: var(--text-sub); }

/* 待审核 / 已拒绝 */
.pending { background: #FFF7E6; text-align: center; }
.pending-icon { width: 72rpx; height: 72rpx; margin: 0 auto; }
.pending-title { font-size: 30rpx; font-weight: 700; margin-top: 8rpx; }

/* 在线开关 */
.row { display: flex; align-items: center; justify-content: space-between; }
.row-main { flex: 1; min-width: 0; margin-right: 16rpx; }
.row-title { font-size: 30rpx; font-weight: 700; }

/* 资料与价格入口 */
.pv-edit-card { display: flex; align-items: center; gap: 18rpx; }
.pv-edit-ico { flex-shrink: 0; }

/* 收益 */
.earn-head { display: flex; align-items: center; justify-content: space-between; }
.earn-head-title { font-size: 30rpx; font-weight: 800; }
.earn-withdraw { flex-shrink: 0; }
.earn-grid { display: flex; margin-top: 8rpx; }
.earn-cell { flex: 1; text-align: center; position: relative; }
.earn-cell::after { content: ''; position: absolute; right: 0; top: 10rpx; bottom: 10rpx; width: 1rpx; background: var(--line); }
.earn-cell:last-child::after { display: none; }
.earn-num { font-size: 34rpx; font-weight: 800; color: var(--primary-deep); }
.earn-label { font-size: 22rpx; margin-top: 6rpx; color: var(--text-sub); }
.earn-total { text-align: center; margin-top: 20rpx; font-size: 24rpx; }

/* 收益卡内入口：收益明细 / 接听记录 */
.earn-nav { margin-top: 20rpx; border-top: 1rpx solid var(--line); }
.earn-nav-item { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 4rpx; border-bottom: 1rpx solid var(--line); }
.earn-nav-item:last-child { border-bottom: none; }
.eni-main { flex: 1; min-width: 0; }
.eni-title { font-size: 28rpx; font-weight: 700; }
.eni-sub { font-size: 22rpx; margin-top: 2rpx; }
.eni-arrow { font-size: 32rpx; margin-left: 12rpx; }

/* 提现记录 */
.tf-empty { font-size: 24rpx; text-align: center; padding: 24rpx 0; }
.transfer-item { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 0; border-bottom: 1rpx solid var(--line); }
.transfer-item:last-of-type { border-bottom: none; }
.claim-tip { font-size: 22rpx; line-height: 1.6; margin-top: 12rpx; }
.btn-sm { font-size: 24rpx; padding: 0 28rpx; height: 56rpx; line-height: 56rpx; border-radius: 28rpx; }
