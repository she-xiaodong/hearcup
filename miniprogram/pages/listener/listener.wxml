<view class="page-bg">
  <!-- 顶栏 -->
  <view class="topbar">
    <view class="listener-title">倾听者平台</view>
  </view>

  <view wx:if="{{loading}}" class="empty">加载中…</view>

  <block wx:else>
    <!-- 未申请 -->
    <view wx:if="{{applyStatus === -1}}" class="card listener-card become">
      <view class="become-title">成为倾听者，用你的温度陪别人一会儿</view>
      <view class="become-sub">通过审核后即可上线接听来电，用碎片时间获得收益。</view>
      <button class="btn btn-primary btn-block" bindtap="goApply">申请入驻</button>
    </view>

    <!-- 待审核 -->
    <view wx:elif="{{applyStatus === 0}}" class="card listener-card pending">
      <view class="pending-icon ico ico-hourglass"></view>
      <view class="pending-title">入驻申请审核中</view>
      <view class="muted">预计 1-3 个工作日出结果，通过后即可上线接听来电。</view>
    </view>

    <!-- 已拒绝 -->
    <view wx:elif="{{applyStatus === 2}}" class="card listener-card pending">
      <view class="pending-icon ico ico-check"></view>
      <view class="pending-title">入驻申请未通过</view>
      <view class="muted">很抱歉，本次申请未通过审核，可补充材料后重新申请。</view>
      <button class="btn btn-ghost btn-block" style="margin-top: 24rpx;" bindtap="goApply">重新申请</button>
    </view>

    <!-- 已通过：平台 -->
    <block wx:else>
      <!-- 在线开关 -->
      <view class="card listener-card">
        <view class="row">
          <view class="row-main">
            <view class="row-title">接听来电</view>
            <view class="muted">{{isOnline ? '已上线，等待来电' : '已下线'}}</view>
          </view>
          <switch checked="{{isOnline}}" bindchange="toggleOnline" color="#3A9E8F" />
        </view>
      </view>

      <!-- 服务中：有已拨号未结算的订单时置顶提醒（让倾听者把握服务时长） -->
      <view wx:if="{{serving}}" class="card listener-card serving-card" bindtap="goProviderCalls">
        <view class="serving-dot"></view>
        <view class="row-main">
          <view class="serving-title">服务中 · {{serving.userName}}</view>
          <view class="muted">套餐 {{serving.minutes}} 分钟 · 已用约 {{serving.usedMin}} 分钟 · 用户可能还在通话，结束后请点右侧去结算</view>
        </view>
        <view class="serving-go">去结束 ›</view>
      </view>

      <!-- 资料与价格设置入口 -->
      <view class="card listener-card pv-edit-card" bindtap="goProviderEdit">
        <view class="ico ico-gear ico-sm pv-edit-ico"></view>
        <view class="row-main">
          <view class="row-title">资料与价格设置</view>
          <view class="muted">修改简介、擅长领域与各档位价格</view>
        </view>
        <text class="muted eni-arrow">›</text>
      </view>

      <!-- 收益 -->
      <view class="card listener-card">
        <view class="earn-head">
          <view class="earn-head-title">今日收益</view>
          <button class="btn btn-primary btn-sm earn-withdraw" bindtap="goWithdraw" style="margin:0;">申请提现</button>
        </view>
        <view class="earn-grid">
          <view class="earn-cell">
            <view class="earn-num">¥{{earnings.today_income}}</view>
            <view class="earn-label">今日收入</view>
          </view>
          <view class="earn-cell">
            <view class="earn-num">{{earnings.today_calls}}</view>
            <view class="earn-label">今日接听</view>
          </view>
          <view class="earn-cell">
            <view class="earn-num">¥{{earnings.withdrawable}}</view>
            <view class="earn-label">可提现</view>
          </view>
        </view>
        <view class="earn-total muted">累计收入 ¥{{earnings.total_earnings}}</view>

        <!-- 入口：收益明细 / 服务订单 / 提现记录 -->
        <view class="earn-nav">
          <view class="earn-nav-item" bindtap="goIncome">
            <view class="eni-main">
              <view class="eni-title">收益明细</view>
              <view class="muted eni-sub">每笔通话收入</view>
            </view>
            <text class="muted eni-arrow">›</text>
          </view>
          <view class="earn-nav-item" bindtap="goProviderCalls">
            <view class="eni-main">
              <view class="eni-title">服务订单</view>
              <view class="muted eni-sub">来电服务、时长与评价</view>
            </view>
            <text class="muted eni-arrow">›</text>
          </view>
          <view class="earn-nav-item" bindtap="goWithdrawRecords">
            <view class="eni-main">
              <view class="eni-title">提现记录</view>
              <view class="muted eni-sub">提现进度与到账领取</view>
            </view>
            <text class="muted eni-arrow">›</text>
          </view>
        </view>
      </view>
    </block>
  </block>

  <view class="safe-bottom"></view>
</view>
