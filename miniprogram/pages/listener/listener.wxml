<view class="page-bg">
  <!-- 顶栏 -->
  <view class="topbar">
    <view class="listener-title">倾听者工作台</view>
  </view>

  <view wx:if="{{loading}}" class="empty">加载中…</view>

  <block wx:else>
    <!-- 未申请 -->
    <view wx:if="{{applyStatus === -1}}" class="card listener-card become">
      <view class="become-title">成为倾听者，用你的温度陪别人一会儿</view>
      <view class="become-sub">通过审核后即可上线接听来电，用碎片时间获得收益。</view>
      <button class="btn btn-primary btn-block" bindtap="goApply">申请入驻</button>
    </view>

    <!-- 待审核 -->
    <view wx:elif="{{applyStatus === 0}}" class="card listener-card pending">
      <view class="pending-icon ico ico-hourglass"></view>
      <view class="pending-title">入驻申请审核中</view>
      <view class="muted">预计 1-3 个工作日出结果，通过后即可上线接听来电。</view>
    </view>

    <!-- 已拒绝 -->
    <view wx:elif="{{applyStatus === 2}}" class="card listener-card pending">
      <view class="pending-icon ico ico-check"></view>
      <view class="pending-title">入驻申请未通过</view>
      <view class="muted">很抱歉，本次申请未通过审核，可补充材料后重新申请。</view>
      <button class="btn btn-ghost btn-block" style="margin-top: 24rpx;" bindtap="goApply">重新申请</button>
    </view>

    <!-- 已通过：工作台 -->
    <block wx:else>
      <!-- 在线开关 -->
      <view class="card listener-card">
        <view class="row">
          <view class="row-main">
            <view class="row-title">接听来电</view>
            <view class="muted">{{isOnline ? '已上线，等待来电' : '已下线'}}</view>
          </view>
          <switch checked="{{isOnline}}" bindchange="toggleOnline" color="#3A9E8F" />
        </view>
      </view>

      <!-- 收益 -->
      <view class="card listener-card">
        <view class="section-title" style="margin: 0;">今日收益</view>
        <view class="earn-grid">
          <view class="earn-cell">
            <view class="earn-num">¥{{earnings.today_income}}</view>
            <view class="earn-label">今日收入</view>
          </view>
          <view class="earn-cell">
            <view class="earn-num">{{earnings.today_calls}}</view>
            <view class="earn-label">今日接听</view>
          </view>
          <view class="earn-cell">
            <view class="earn-num">¥{{earnings.withdrawable}}</view>
            <view class="earn-label">可提现</view>
          </view>
        </view>
        <view class="earn-total muted">累计收入 ¥{{earnings.total_earnings}}</view>
      </view>

      <!-- 分佣领取（商家转账到零钱：发起后须手动领取） -->
      <view wx:if="{{transfers.length > 0}}" class="card listener-card">
        <view class="section-title" style="margin: 0 0 12rpx;">分佣领取</view>
        <view wx:for="{{transfers}}" wx:key="id" class="transfer-item">
          <view class="row-main">
            <view class="row-title">¥{{item.amount}} <text class="muted" style="font-weight:400;font-size:22rpx;margin-left:8rpx;">{{item.stateText}}</text></view>
            <view class="muted" style="font-size:22rpx;">{{item.timeText}}</view>
          </view>
          <button wx:if="{{item.canClaim}}" class="btn btn-primary btn-sm" data-id="{{item.id}}" bindtap="onClaim" style="margin:0;">去领取</button>
          <text wx:else class="muted" style="font-size:24rpx;">{{item.stateText}}</text>
        </view>
        <view class="muted claim-tip">微信转账需手动领取才会到账，点击「去领取」按提示操作。</view>
      </view>

      <!-- 低版本 Android 提示 -->
      <view wx:if="{{lowAndroid}}" class="card listener-card warn">
        <view class="warn-title">⚠️ 你的系统版本较低</view>
        <view class="muted">Android 10 以下不支持锁屏来电弹窗，来电会以微信通知提醒，请尽量保持微信在前台运行。</view>
      </view>

      <!-- 保活设置 -->
      <view class="card listener-card">
        <view class="section-title" style="margin: 0;">保持在线</view>
        <view class="row" style="margin-top: 8rpx;">
          <view class="row-main">
            <view class="row-title" style="font-size: 28rpx;">后台音频保活</view>
            <view class="muted">播放极轻量静音，降低被系统回收概率</view>
          </view>
          <switch checked="{{keepAlive}}" bindchange="toggleKeepAlive" color="#3A9E8F" />
        </view>
        <view class="keep-guide" bindtap="showKeepGuide">
          <view class="kg-main">
            <view class="kg-title">{{platform === 'ios' ? '显示在聊天顶部（推荐）' : '多任务界面锁定（推荐）'}}</view>
            <view class="muted">点击查看具体操作步骤</view>
          </view>
          <text class="muted">›</text>
        </view>
      </view>
    </block>
  </block>

  <view class="safe-bottom"></view>
</view>
