.page { padding: 32rpx 32rpx 60rpx; }
.hd { margin-bottom: 28rpx; }
.hd-title { font-size: 40rpx; font-weight: 700; color: var(--text, #2C3A3F); }
.hd-sub { font-size: 24rpx; color: #8A8FA3; margin-top: 8rpx; }

.card { background: #fff; border-radius: 20rpx; padding: 28rpx; margin-bottom: 24rpx; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05); }
.card-title { font-size: 28rpx; font-weight: 600; color: var(--primary-deep, #2A8C7F); margin-bottom: 20rpx; }

.row { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 0; border-top: 1rpx solid #EEF1F3; }
.row:first-of-type { border-top: none; }
.row-label { font-size: 28rpx; color: #2C3A3F; width: 150rpx; flex: none; }
.row-input { flex: 1; font-size: 26rpx; color: #5A6470; text-align: right; }

.hint { font-size: 22rpx; color: #98A0AC; line-height: 1.6; margin-top: 16rpx; }

.btn-row { display: flex; gap: 16rpx; margin-top: 24rpx; }
.btn-mini {
  flex: 1; margin: 0; font-size: 26rpx; padding: 16rpx 0; line-height: 1.4;
  background: #F2F6F7; color: #2C3A3F; border-radius: 14rpx;
}
.btn-mini.btn-primary { background: linear-gradient(135deg, #6FCFBA, #4FB8A8); color: #fff; font-weight: 600; }

/* 自检结果 */
.step { display: flex; align-items: flex-start; padding: 18rpx 0; border-top: 1rpx solid #F2F5F6; }
.step:first-child { border-top: none; }
.step-dot { width: 16rpx; height: 16rpx; border-radius: 50%; margin-top: 10rpx; margin-right: 16rpx; flex: none; }
.step-body { flex: 1; min-width: 0; }
.step-name { font-size: 28rpx; color: #2C3A3F; }
.step-detail { font-size: 22rpx; color: #98A0AC; margin-top: 6rpx; word-break: break-all; line-height: 1.5; }
.step-mark { font-size: 30rpx; color: #8A8FA3; margin-left: 12rpx; flex: none; }
.empty { font-size: 24rpx; color: #B4BAC4; text-align: center; padding: 30rpx 0; }

/* 环境状态 */
.env-row { display: flex; align-items: center; justify-content: space-between; padding: 14rpx 0; font-size: 26rpx; }
.env-k { color: #5A6470; flex: none; }
.env-v { color: #2C3A3F; text-align: right; word-break: break-all; margin-left: 20rpx; }
.env-v.on { color: #4FB8A8; font-weight: 600; }
.env-v.off { color: #FF8A8A; }

.result-box {
  margin-top: 20rpx; padding: 20rpx; background: #F7FAFA; border-radius: 12rpx;
  font-size: 22rpx; color: #5A6470; white-space: pre-wrap; word-break: break-all; line-height: 1.6;
}
