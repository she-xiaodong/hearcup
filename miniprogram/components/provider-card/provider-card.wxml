<view class="pc-card" bindtap="onTapCard">
  <view class="pc-head">
    <view class="pc-av">
      <image class="pc-avatar-img" src="{{provider.avatar || '/images/default_avatar.png'}}" mode="aspectFill" />
      <!-- 性别小图标（头像右下角） -->
      <text class="pc-gen-badge {{provider.gender === 1 ? 'gen-m' : 'gen-f'}}">{{provider.gender === 1 ? '♂' : '♀'}}</text>
    </view>
    <view class="pc-info">
      <!-- 第一行：名称 + 等级；在线/离线靠右 -->
      <view class="pc-name-row">
        <view class="pc-nl">
          <text class="pc-name">{{provider.nickName}}</text>
          <text class="pc-level">{{provider.levelText}}</text>
        </view>
        <text class="st-tag {{provider.is_online?'st-on':'st-off'}}">{{provider.is_online?'在线':'离线'}}</text>
      </view>
      <!-- 第二行：评分 + 次数 + H号 -->
      <view class="pc-meta">
        <text class="stars">★</text>
        <text class="rating-num">{{provider.rating}}</text>
        <text class="muted">{{provider.total_sessions}}次服务</text>
        <text class="muted pc-hno" wx:if="{{provider.h_no}}">H号 {{provider.h_no}}</text>
      </view>
    </view>
  </view>

  <view class="pc-tags">
    <text wx:for="{{provider.expertise}}" wx:key="*this" class="tag">{{item}}</text>
  </view>

  <view class="pc-foot">
    <!-- 起价对应 15 分钟档 -->
    <view class="pc-price">
      <view class="pc-price-main"><text class="pc-price-num">{{priceCoins}}</text><text class="muted"> H币起</text></view>
      <view class="pc-price-sub">15分钟档</view>
    </view>
    <view class="pc-actions">
      <view class="pc-call pc-call-voice" catchtap="onCall">去咨询</view>
    </view>
  </view>
</view>
